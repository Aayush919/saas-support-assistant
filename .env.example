# Copy to ../.env (repo root) or server/.env — never commit real keys.
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_BASE_URL=https://api.sarvam.ai/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.1

# Demo cost chip, in US dollars per 1 million tokens (MTOK = million tokens).
# 0.30 = $0.30 per 1,000,000 input tokens. 0.90 = $0.90 per 1,000,000 output tokens.
# Official Sarvam list for this model is INR, not USD:
# ₹29.28 input / ₹10.98 cached input / ₹73.20 output per 1M tokens.
# These two numbers are a rounded dollar stand-in for the UI, not a bill.
PRICE_INPUT_PER_MTOK=0.30
PRICE_OUTPUT_PER_MTOK=0.90

# API
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_S=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# React client
VITE_API_BASE_URL=http://localhost:8000
